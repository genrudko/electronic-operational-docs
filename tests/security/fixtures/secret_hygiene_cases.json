{
  "schema": 1,
  "cases": [
    {
      "id": "safe-runtime-placeholder",
      "path": "compose.example.yaml",
      "fragments": ["POSTGRES_PASSWORD", ": ${POSTGRES_PASSWORD:?required}"],
      "expected_rule": null
    },
    {
      "id": "safe-replace-placeholder",
      "path": "deploy/example.env",
      "fragments": ["DJANGO_SECRET_KEY=replace-with-a-long-random-secret"],
      "expected_rule": null
    },
    {
      "id": "safe-generated-shell-assignment",
      "path": "bootstrap.sh",
      "fragments": ["POSTGRES_PASSWORD=\"$(python -c 'import secrets; print(secrets.token_urlsafe(32))')\""],
      "expected_rule": null
    },
    {
      "id": "safe-named-test-fixture",
      "path": "tests/test_login.py",
      "fragments": ["ADMIN_PASSWORD=\"FixtureOnlyTestPassword!2026\""],
      "expected_rule": null
    },
    {
      "id": "safe-error-message",
      "path": "entrypoint.sh",
      "fragments": ["echo \"Unsafe configuration: POSTGRES_PASSWORD is required.\" >&2"],
      "expected_rule": null
    },
    {
      "id": "safe-exact-redacted-artifact",
      "path": ".github/workflows/check.yml",
      "fragments": [
        "- name: Sanitize\n  run: |\n    python scripts/secret_hygiene.py redact --input raw.log --output diagnostics.sanitized.txt\n",
        "- name: Upload\n  uses: actions/upload-artifact@v7\n  with:\n    path: diagnostics.sanitized.txt"
      ],
      "expected_rule": null
    },
    {
      "id": "committed-password",
      "path": "settings.env",
      "fragments": ["ADMIN_PASS", "WORD=", "Committed", "Credential", "Only", "!2026"],
      "expected_rule": "explicit-credential-assignment"
    },
    {
      "id": "bare-workflow-password",
      "path": ".github/workflows/check.yml",
      "fragments": ["POSTGRES_PASSWORD: predictable_ci_password"],
      "expected_rule": "explicit-credential-assignment"
    },
    {
      "id": "token-like-value",
      "path": "config.txt",
      "fragments": ["gh", "p_", "abcdefghijklmnopqrstuvwxyz123456"],
      "expected_rule": "token-like-value"
    },
    {
      "id": "private-key-marker",
      "path": "key.pem",
      "fragments": ["-----BEGIN OPENSSH PRI", "VATE KEY-----"],
      "expected_rule": "private-key-marker"
    },
    {
      "id": "database-url-password",
      "path": "settings.py",
      "fragments": ["DATABASE_URL=postgresql://user:", "CommittedDbCredential!", "@db/eod"],
      "expected_rule": "secret-bearing-dsn"
    },
    {
      "id": "reusable-demo-credential",
      "path": "seed.py",
      "fragments": ["EOD_DEMO_PASS", "WORD = ", "\"CommittedDemo", "Credential!\""],
      "expected_rule": "reusable-demo-credential"
    },
    {
      "id": "password-printed-by-shell",
      "path": "bootstrap.sh",
      "fragments": ["echo \"$ADMIN_PASS", "WORD\""],
      "expected_rule": "credential-output"
    },
    {
      "id": "secret-exposed-through-set-x",
      "path": "bootstrap.sh",
      "fragments": ["set -x\nprintf '%s' \"$API_", "TOKEN\""],
      "expected_rule": "shell-xtrace-secret"
    },
    {
      "id": "workflow-summary-leak",
      "path": ".github/workflows/check.yml",
      "fragments": [
        "- name: Unsafe summary\n  run: |\n    raw_output=\"$(command)\"\n    printf '%s\\n' \"$raw_",
        "output\" >>\"$GITHUB_STEP_SUMMARY\""
      ],
      "expected_rule": "workflow-summary-leak"
    },
    {
      "id": "artifact-leak",
      "path": ".github/workflows/check.yml",
      "fragments": [
        "- name: Unsafe artifact\n  uses: actions/upload-artifact@v7\n  with:\n    path: diagnostic",
        ".log"
      ],
      "expected_rule": "artifact-leak"
    }
  ]
}
