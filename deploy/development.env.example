# Copy to /srv/eod/secrets/development.env and generate all secret values locally.
# Empty mandatory values fail closed; never commit the populated file.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
POSTGRES_DB=eod_development
POSTGRES_USER=eod_development
POSTGRES_PASSWORD=
EOD_DEMO_USER_PASSWORD=
EOD_DEVELOPMENT_PORT=8766
TIME_ZONE=Europe/Moscow
