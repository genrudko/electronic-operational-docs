FROM python:3.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN addgroup --system eod \
    && adduser --system --ingroup eod --home /app eod

WORKDIR /app
COPY --chown=eod:eod pyproject.toml manage.py ./
COPY --chown=eod:eod src ./src
RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install . \
    && mkdir -p /app/staticfiles \
    && chown -R eod:eod /app/staticfiles

USER eod
EXPOSE 8766
CMD ["gunicorn", "--bind", "0.0.0.0:8766", "--workers", "2", "--threads", "4", "--timeout", "60", "--access-logfile", "-", "--error-logfile", "-", "eod_config.wsgi:application"]
