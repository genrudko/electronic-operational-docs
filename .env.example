# Development defaults. Do not reuse these values for production-capable operation.
EOD_DEPLOYMENT_MODE=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

DB_ENGINE=sqlite
SQLITE_PATH=data/dev.sqlite3
EOD_DATABASE_PROFILE=development
EOD_ALLOW_SQLITE_PATH_OVERRIDE=0

POSTGRES_DB=eod
POSTGRES_USER=eod
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

# Production-capable profile (compose.production.yaml hard-codes mode=production).
# Required operator values: strong DJANGO_SECRET_KEY, explicit hosts/origins,
# PostgreSQL credentials, and the reverse-proxy/TLS contract below.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
EOD_TLS_TERMINATION=reverse-proxy
EOD_TRUST_PROXY_HEADERS=1
EOD_TRUST_X_FORWARDED_HOST=0
EOD_PRODUCTION_PORT=8767

EOD_DEMO_USER_PASSWORD=
TIME_ZONE=Europe/Moscow
