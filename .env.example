DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-this-in-real-deployment
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Europe/Moscow

# Локальная разработка без Docker.
DB_ENGINE=sqlite
SQLITE_PATH=data/dev.sqlite3

# Целевой PostgreSQL-профиль.
POSTGRES_DB=eod
POSTGRES_USER=eod
POSTGRES_PASSWORD=eod_local_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
