# Copy to .env for local development and generate values locally.
# Empty mandatory values fail closed; never commit the populated file.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Europe/Moscow

# Local development without Docker.
DB_ENGINE=sqlite
SQLITE_PATH=data/dev.sqlite3

# Target PostgreSQL profile.
POSTGRES_DB=eod
POSTGRES_USER=eod
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

# Optional local demo access. Leave empty to keep demo accounts unusable.
EOD_DEMO_USER_PASSWORD=
