FROM mcr.microsoft.com/playwright/python@sha256:678457c4c323b981d8b4befc57b95366bb1bb6aa30057b1269f6b171e8d9975a

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /evidence

COPY requirements/locks/browser.txt /evidence/requirements/locks/browser.txt

RUN python -m pip install --disable-pip-version-check --require-hashes \
    -r /evidence/requirements/locks/browser.txt \
    && python -m pip check

LABEL org.opencontainers.image.title="EOD browser evidence environment" \
      org.opencontainers.image.version="playwright-python-1.58.0" \
      org.opencontainers.image.description="Immutable browser/test tooling boundary for DEPENDENCY-PROVENANCE-001"
